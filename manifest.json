{
  "manifest_version": 3,
  "name": "SnipeBot",
  "version": "1.5",
  "description": "Multi-store automated checkout assistant — independent bots per browser window for product drops.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel", "alarms", "debugger", "webNavigation", "notifications", "tts"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": { "16": "icons/Logo4.png", "48": "icons/Logo4.png", "128": "icons/Logo4.png" },
  "side_panel": { "default_path": "popup.html" },
  "action": { "default_title": "SnipeBot", "default_icon": { "16": "icons/Logo4.png", "48": "icons/Logo4.png", "128": "icons/Logo4.png" } },
  "commands": {
    "start-bot": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "Start / Stop the bot"
    },
    "test-bot": {
      "suggested_key": { "default": "Ctrl+Shift+E" },
      "description": "Test run / Stop"
    },
    "save-config": {
      "suggested_key": { "default": "Ctrl+Shift+U" },
      "description": "Save config"
    }
  },
  "content_scripts": [
    { "matches": ["http://localhost:3000/*"], "js": ["stores.js", "sams.js", "content.js"], "run_at": "document_end" },
    { "matches": ["https://www.walmart.com/*"], "js": ["stores.js", "sams.js", "walmart.js", "content.js"], "run_at": "document_start" }
  ],
  "background": { "service_worker": "background.js" }
}
